From 530ce039af09f1d97b889d002c23287bcde0df47 Mon Sep 17 00:00:00 2001
From: nomoto <nomoto@aptpod.co.jp>
Date: Thu, 11 Jun 2026 16:29:47 +0900
Subject: [PATCH] fix: Add connect/handshake/read-header timeouts to prevent
 reconnection delay

mender-update has no timeout on TCP connect, TLS handshake, or response
header read. When packets are silently dropped (e.g. LTE disconnection)
on an established connection, the client hangs until TCP keep-alive
detects the dead peer (~9-10 minutes) before retrying.

Bound these phases with the beast::tcp_stream native timer
(expires_after), the same mechanism mender 5.1.0 already uses for the
body read:
- TCP connect: 30s
- TLS handshake: 30s
- Response header read: 60s

Connect and TLS handshake normally complete in milliseconds (LAN) to a
few seconds (LTE); 30s gives >10x margin. Response headers normally
return within a few seconds; 60s gives >10x margin and replaces the
~9 minute keep-alive detection. The connect is switched from
asio::async_connect on the raw socket to beast::tcp_stream::async_connect
so the stream timer applies. The timer is disarmed (expires_never)
before request writes and after the header read, leaving WriteHeader,
WriteBody and the body read (existing 5 minute timeout) unchanged.

Upstream-Status: Inappropriate [configuration specific]
---
 src/common/http/platform/beast/http.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/common/http/platform/beast/http.cpp b/src/common/http/platform/beast/http.cpp
index 6030ea6..e8b344f 100644
--- a/src/common/http/platform/beast/http.cpp
+++ b/src/common/http/platform/beast/http.cpp
@@ -693,8 +693,8 @@ void Client::ResolveHandler(
 
 	auto &cancelled = cancelled_;
 
-	asio::async_connect(
-		stream_->lowest_layer(),
+	stream_->next_layer().next_layer().expires_after(chrono::seconds(30));
+	stream_->next_layer().next_layer().async_connect(
 		resolver_results_,
 		[this, cancelled](const error_code &ec, const asio::ip::tcp::endpoint &endpoint) {
 			if (!*cancelled) {
@@ -766,6 +766,7 @@ void Client::HandshakeHandler(
 
 	auto &cancelled = cancelled_;
 
+	stream_->next_layer().next_layer().expires_after(chrono::seconds(30));
 	stream.async_handshake(
 		ssl::stream_base::client, [this, cancelled, endpoint](const error_code &ec) {
 			if (*cancelled) {
@@ -783,6 +784,8 @@ void Client::HandshakeHandler(
 
 
 void Client::ConnectHandler(const error_code &ec, const asio::ip::tcp::endpoint &endpoint) {
+	stream_->next_layer().next_layer().expires_never();
+
 	if (ec) {
 		CallErrorHandler(ec, request_, header_handler_);
 		return;
@@ -980,8 +983,11 @@ void Client::ReadHeader() {
 	auto &cancelled = cancelled_;
 	auto &response_data = response_data_;
 
+	stream_->next_layer().next_layer().expires_after(chrono::seconds(60));
+
 	auto handler = [this, cancelled, response_data](const error_code &ec, size_t num_read) {
 		if (!*cancelled) {
+			stream_->next_layer().next_layer().expires_never();
 			ReadHeaderHandler(ec, num_read);
 		}
 	};
