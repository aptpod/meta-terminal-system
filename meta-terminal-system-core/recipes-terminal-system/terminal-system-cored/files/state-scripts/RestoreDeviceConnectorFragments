#!/bin/bash

# Restore device connector fragment files from backup during rollback.

FRAGMENT_DIR="/var/lib/core/docker-compose/measurement/device_connector"

log() {
    echo "[RestoreDeviceConnectorFragments] $1"
}

for backup_file in "$FRAGMENT_DIR"/*.fragment.json.bak; do
    [ -e "$backup_file" ] || continue

    fragment_file="${backup_file%.bak}"
    fragment_id=$(basename "$fragment_file" .fragment.json)

    mv "$backup_file" "$fragment_file"

    log "Restored: id=$fragment_id"
done

exit 0
