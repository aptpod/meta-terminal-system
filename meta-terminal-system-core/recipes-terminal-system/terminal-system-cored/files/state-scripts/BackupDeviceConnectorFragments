#!/bin/bash

# Backup device connector fragment files before migration.
# This backup is used for rollback if the update fails.

FRAGMENT_DIR="/var/lib/core/docker-compose/measurement/device_connector"

for fragment_file in "$FRAGMENT_DIR"/*.fragment.json; do
    [ -e "$fragment_file" ] || continue
    cp "$fragment_file" "${fragment_file}.bak"
done

exit 0
