diff --git a/configs/rpi_4_32b_defconfig b/configs/rpi_4_32b_defconfig
index 786b88127fe..5aa6382ace9 100644
--- a/configs/rpi_4_32b_defconfig
+++ b/configs/rpi_4_32b_defconfig
@@ -1,3 +1,4 @@
