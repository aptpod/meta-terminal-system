#!/bin/bash

# Migrate Audio (Onboard) volume settings from old format to new format.
# DC_AUDIO_VOLUME: 0-20 -> 0-100 (multiply by 5)
# DC_AUDIO_BOOST: 0-3 -> 0/32/68/100

function check_os_version() {
    os_version="$(cat /etc/os-release | grep VERSION_ID | sed -e 's/^VERSION_ID=\(.*\)$/\1/')"

    # Target: versions before 1.3.0 (1.1.x or 1.2.x)
    if [[ ! $os_version =~ 1\.[12]\.[0-9]+ ]]; then
        exit 0
    fi
}

function convert_volume() {
    local old_value=$1
    echo $((old_value * 5))
}

function convert_boost() {
    local old_value=$1
    case $old_value in
        0) echo 0 ;;
        1) echo 32 ;;
        2) echo 68 ;;
        3) echo 100 ;;
        *) echo 32 ;;
    esac
}

function update_device_connectors() {
    json="$(curl --fail-with-body -sSL http://localhost:8081/api/device_connectors)"

    echo "$json" | jq -c '.[] | select(.service_id | test("Audio \\(Onboard\\)"))' | while read -r line; do
        id="$(echo $line | jq -cr '.id')"
        service_substitutions="$(echo $line | jq -c '.service_substitutions')"

        # Extract current values
        old_volume="$(echo "$service_substitutions" | jq -r '.[] | select(startswith("DC_AUDIO_VOLUME=")) | split("=")[1]' | head -1)"
        old_boost="$(echo "$service_substitutions" | jq -r '.[] | select(startswith("DC_AUDIO_BOOST=")) | split("=")[1]' | head -1)"

        # Skip if no values found (using new format already)
        if [ -z "$old_volume" ] && [ -z "$old_boost" ]; then
            continue
        fi

        # Convert values
        new_volume=""
        new_boost=""

        if [ -n "$old_volume" ] && [ "$old_volume" -le 20 ] 2>/dev/null; then
            new_volume=$(convert_volume "$old_volume")
        fi

        if [ -n "$old_boost" ] && [ "$old_boost" -le 3 ] 2>/dev/null; then
            new_boost=$(convert_boost "$old_boost")
        fi

        # Update service_substitutions
        updated_substitutions="$service_substitutions"

        if [ -n "$new_volume" ]; then
            updated_substitutions="$(echo "$updated_substitutions" | jq --arg old "DC_AUDIO_VOLUME=$old_volume" --arg new "DC_AUDIO_VOLUME=$new_volume" 'map(if . == $old then $new else . end)')"
            echo "[INFO] Migrating DC_AUDIO_VOLUME: $old_volume -> $new_volume for device connector $id"
        fi

        if [ -n "$new_boost" ]; then
            updated_substitutions="$(echo "$updated_substitutions" | jq --arg old "DC_AUDIO_BOOST=$old_boost" --arg new "DC_AUDIO_BOOST=$new_boost" 'map(if . == $old then $new else . end)')"
            echo "[INFO] Migrating DC_AUDIO_BOOST: $old_boost -> $new_boost for device connector $id"
        fi

        # Apply update
        # Since it falls outside the existing regex range, force the update
        if [ "$updated_substitutions" != "$service_substitutions" ]; then
            curl --fail-with-body -sSL -X PATCH -d "{\"service_substitutions\": $updated_substitutions}" "http://localhost:8081/api/device_connectors/$id?force=true"
        fi
    done
}

check_os_version
update_device_connectors
